{
  "name": "posthaste",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui -- --dev && vite",
    "build": "npm run build:ui && vite build",
    "build:ui": "bash scripts/build-ui.sh",
    "format": "prettier --write \"ui/styles/**/*.css\" \"ui/*.js\" \"ui/tests/*.mjs\"",
    "format:check": "prettier --check \"ui/styles/**/*.css\" \"ui/*.js\" \"ui/tests/*.mjs\"",
    "test:ui": "node --test ui/tests/*.test.mjs",
    "tauri": "tauri",
    "check": "npm run format:check && npm run check:rules",
    "check:rules": "bash scripts/check-rules.sh",
    "sync:rules": "bash scripts/sync-rules.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  }
}
